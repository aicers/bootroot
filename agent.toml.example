# Bootroot Agent Configuration Example (Multi-Profile)
# Rename this file to agent.toml to use it.
# bootroot-agent runs as a host daemon and reads this file for its profiles.

# Support email address for ACME registration
email = "admin@example.com"

# ACME Directory URL
# Default: https://localhost:9000/acme/acme/directory (Step CA)
server = "https://localhost:9000/acme/acme/directory"

# Root domain used to auto-generate the DNS SAN
# Format: <instance_id>.<service_name>.<hostname>.<domain>
domain = "trusted.domain"

# Scheduler settings
[scheduler]
max_concurrent_issuances = 3

# ACME behavior settings
[acme]
# Directory fetch retries and backoff (seconds)
directory_fetch_attempts = 10
directory_fetch_base_delay_secs = 1
directory_fetch_max_delay_secs = 10
# Order polling behavior
poll_attempts = 15
poll_interval_secs = 2
http_responder_url = "http://localhost:8080"
http_responder_hmac = "change-me"
http_responder_timeout_secs = 5
http_responder_token_ttl_secs = 300

# Host-local registrar endpoint (Linux only).
#
# When enabled, bootroot-agent serves the registrar's mint and
# deregister verbs on a systemd-activated AF_UNIX socket inherited as
# fd 3.  The daemon never creates the socket: systemd owns
# /run/bootroot/registrar.sock, its 0700 mode and its root ownership,
# through the checked-in systemd/bootroot-registrar.socket unit.  There
# is deliberately no socket path here, and no TCP option.
#
# Enabling it is supported.  The daemon builds the registrar verb layer
# from the [registrar] keys below and registers a production request
# handler over it.  [registrar] state_file is REQUIRED when this is
# true, and a missing provisioning config, state file, internal
# credential or audit store fails startup with a named diagnostic.
# Deregistration is served end to end; a mint is refused until the wire
# spelling of a request's spec is settled by the contract that owns it.
#
# Every key here is fixed for the process lifetime.  The listening
# descriptor is inherited, and the certificate material at all four
# paths is read, once before the reload loop, so a SIGHUP that changes
# any of the five is rejected and the running daemon is left as it is;
# changing one takes a service restart.  On a non-Linux target an
# enabled endpoint fails config validation.
#
# The endpoint terminates mTLS.  It presents the material below and
# accepts exactly one client identity,
# <instance>.bootroot-registrar.<host>.<network.domain>.  A caller
# presenting no client certificate, or one that does not verify against
# the pinned subset of trust.ca_bundle_path, fails the handshake;
# trust.ca_bundle_path and trust.trusted_ca_sha256 must therefore both
# be configured when the endpoint is enabled.
#
# server_cert_path must hold the endpoint's leaf FOLLOWED BY its issuer
# chain, up to a certificate pinned in trust.trusted_ca_sha256.  A
# leaf-only file loads cleanly and is then rejected by every correctly
# pinned caller, so the daemon refuses to start on one instead.
#
# client_cert_path and client_key_path hold the leaf the co-located
# registrar authenticates back with, 001.bootroot-registrar.<host>.
# <network.domain>, and its key.  That process reads them, and the
# provisioning tool places the INITIAL certificate at them; the endpoint
# anchor pin file registrar-endpoint-anchors.sha256 is looked for in the
# same directory as client_cert_path.
#
# All four paths are REQUIRED when enabled = true, and there is no
# default for any of them: an unset one fails config validation before
# anything is read or requested.  The daemon issues both leaves itself
# at start, under the bootroot-internal credential, whenever the
# material at a configured path is missing, unreadable, unparseable,
# key-mismatched, SAN-mismatched, outside its validity window in either
# direction, or no longer chained to trust.ca_bundle_path.  Material
# that is usable is left byte-identical.
[registrar_endpoint]
enabled = false
# server_cert_path = "/etc/bootroot/certs/registrar-endpoint.crt"
# server_key_path = "/etc/bootroot/certs/registrar-endpoint.key"
# client_cert_path = "/etc/bootroot/certs/registrar-client.crt"
# client_key_path = "/etc/bootroot/certs/registrar-client.key"

# Registrar audit records (daemon-owned).
#
# bootroot writes its own append-only audit trail for the registrar's
# mint and deregister verbs, beside — never instead of — OpenBao's
# mandatory file audit device.  The registrar cannot read, append to,
# delete or redirect it, and no request field reaches any value here.
#
# audit_record_dir must be absolute and is created root-owned 0700, with
# any missing ancestor created root-owned 0755; existing entries are
# left exactly as they are.  A symlink, a wrong owner or a group- or
# world-writable directory or immediate parent is refused outright.
#
# The active file is registrar-audit.jsonl.  It is rotated before an
# append would take it past audit_max_file_bytes (minimum 65536, which
# is what guarantees one maximum-size record fits a freshly rotated
# file), and at most audit_max_retained_files rotated generations are
# kept beside it.  The defaults are a hard ceiling of 8 MiB x 17 =
# ~136 MiB.  audit_min_retain_days records the retention target; where
# the two disagree, the file count wins.
#
# The verb-layer keys below provision what the endpoint serves.  They are
# validated on every host, whether or not the endpoint is enabled, and
# every duration is a humantime string rather than a bare count of
# seconds.  state_file has no default and is required only when the
# endpoint is enabled: it names the state.json bootroot init wrote, which
# is where the recorded OpenBao URL, KV mount and secrets directory come
# from — there is deliberately no key for any of the three.  There is no
# key for secret_id metadata either, and none for the active root
# fingerprint, which is derived from <secrets_dir>/certs/root_ca.crt.
[registrar]
audit_record_dir = "/var/lib/bootroot/registrar-audit"
audit_max_file_bytes = 8388608
audit_max_retained_files = 16
audit_min_retain_days = 90
# state_file = "/opt/bootroot/state.json"
provisioning_config_path = "/etc/clumit-security/provisioning.toml"
max_wrap_ttl = "30m"
role_token_ttl = "1h"
role_secret_id_ttl = "24h"
secret_id_num_uses = 0
# secret_id_ttl = "10m"
# secret_id_token_bound_cidrs = ["10.0.0.0/8"]

# Trust settings for CA bundle verification/storage
[trust]
# Path to save the CA bundle (intermediate/root)
ca_bundle_path = "certs/ca-bundle.pem"
# SHA-256 fingerprints of trusted CA certs (hex)
trusted_ca_sha256 = ["<sha256-hex>"]

# Retry settings for issuance attempts
[retry]
backoff_secs = [5, 10, 30]

# Optional global External Account Binding (EAB) Credentials
# [eab]
# kid = "your-key-id"
# hmac = "your-hmac-key"

# Profiles (one per daemon instance)
[[profiles]]
# Deployment-wide unique registration key.  Required.  Names the OpenBao
# KV subtree this profile polls (bootroot/services/<registration_id>/...)
# and the per-profile fast-poll state filename.  Lowercase letters,
# digits and hyphens, starting and ending alphanumeric, max 131 chars.
# It is NOT part of the certificate SAN.
registration_id = "edge-node-01-edge-proxy-001"
# Second label of the DNS SAN.  Must be a DNS label (max 63 chars).
service_name = "edge-proxy"
instance_id = "001"
hostname = "edge-node-01"

[profiles.paths]
# Path to save the certificate
cert = "certs/edge-proxy-a.pem"
# Path to save the private key
key = "certs/edge-proxy-a.key"

# Daemon mode settings (auto-renewal)
[profiles.daemon]
# How often to check certificate validity
check_interval = "1h"
# Start renewal 16 hours before expiry
renew_before = "16h"
# Randomize check interval by +/- jitter (0s disables)
check_jitter = "0s"

[profiles.retry]
# Optional per-profile retry backoff override
backoff_secs = [5, 10, 30]

# Post-renewal hooks
[profiles.hooks.post_renew]
# Commands to run after a successful renewal
# success = [
#   {
#     command = "nginx"
#     args = ["-s", "reload"]
#     working_dir = "/etc/nginx"
#     timeout_secs = 30
#     retry_backoff_secs = [5, 10, 30]
#     max_output_bytes = 4096
#     on_failure = "continue"
#   }
# ]
# Commands to run after a failed renewal
# failure = [
#   {
#     command = "logger"
#     args = ["bootroot renewal failed"]
#     timeout_secs = 30
#     on_failure = "stop"
#   }
# ]

# Optional per-profile EAB override
# [profiles.eab]
# kid = "your-key-id"
# hmac = "your-hmac-key"

# OpenBao client settings used by the remote-bootstrap force-reissue
# fast-poll loop.  Required on service hosts running with
# --delivery-mode remote-bootstrap: without it the agent has no consumer
# for `bootroot rotate force-reissue` requests, so certificates would only
# reissue on the next check_interval tick.
#
# The connection fields (url, kv_mount, role_id_path, secret_id_path,
# ca_bundle_path) are auto-provisioned by `bootroot-remote bootstrap`
# on every run and do not need to be hand-edited.  An absolute
# `state_path` adjacent to this file is also provisioned on the first
# bootstrap that lands the section, so fast-poll state survives
# restarts under systemd-style supervisors whose cwd is not guaranteed
# to be writable or stable.  Operator-tuned fast_poll_interval /
# state_path entries are preserved across reruns.
# When configured, bootroot-agent authenticates to OpenBao directly via
# AppRole and polls each profile's reissue KV path on the configured
# fast_poll_interval, so force-reissue requests are picked up within tens
# of seconds rather than waiting for the next check_interval tick.
# [openbao]
# url = "https://openbao.internal:8200"
# kv_mount = "secret"
# role_id_path = "/etc/bootroot/role_id"
# secret_id_path = "/etc/bootroot/secret_id"
# # Required when url uses https://
# ca_bundle_path = "/etc/bootroot/ca-bundle.pem"
# # Opt-in for a non-loopback plaintext http:// url.  Over plaintext the
# # AppRole login and every KV poll response carry role_id/secret_id,
# # responder HMAC, and EAB in cleartext, so validation rejects a
# # non-loopback http:// url unless this is set.  Loopback plaintext
# # (localhost, 127.0.0.0/8, [::1]) and https:// never need it.  When set
# # against a non-loopback plaintext url, the fast-poll loop logs a
# # startup warning.  Prefer https:// in production.
# allow_plaintext_http = false
# # Poll cadence; defaults to 30s
# fast_poll_interval = "30s"
# # Persists `last_reissue_seen_version` across restarts.  Must be an
# # absolute path — config validation rejects a cwd-relative value
# # because agent process cwd is not contracted to be writable or
# # stable under systemd-style supervisors.  Bootstrap provisions an
# # absolute path next to this file when missing; set explicitly to
# # pin a custom location (e.g. /var/lib/bootroot/...).
# state_path = "/var/lib/bootroot/agent-state.json"
